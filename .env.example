# Docuopsy Environment Configuration
# Keys never live in tracked source. Real values go in the gitignored
# `.env` / `src-tauri/.env.dev`, or in `KIE_AI_API_KEY_DEV` in the shell env.

# KIE AI Gateway Configuration (release builds)
# Provider: KIE AI (https://kie.ai)
# Default Model: deepseek-v4-1-flash
KIE_AI_API_KEY=your_kie_ai_api_key_here
KIE_AI_BASE_URL=https://api.kie.ai/openai/v1
KIE_AI_DEFAULT_MODEL=deepseek-v4-1-flash

# Debug-build Rust fallback, read from src-tauri/.env.dev
KIE_AI_API_KEY_DEV=your_debug_only_kie_ai_key_here

# Browser-dev fallback only; the Vite proxy attaches it to /api/omniroute requests
# so it is read by Node and never inlined into the bundle. Tauri uses the Rust command.
OMNIROUTE_API_KEY=your_omniroute_key_here

# Logging Level: error, warn, info, debug, trace
DOCUOPSY_LOG_LEVEL=info

