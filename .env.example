# Docuopsy Environment Configuration
# Copy this file to .env and configure your credentials

# KIE AI Gateway Configuration
# Provider: KIE AI (https://kie.ai)
# Default Model: deepseek-v4-1-flash
KIE_AI_API_KEY=your_kie_ai_api_key_here
KIE_AI_BASE_URL=https://api.kie.ai/openai/v1
KIE_AI_DEFAULT_MODEL=deepseek-v4-1-flash

# Logging Level: error, warn, info, debug, trace
DOCUOPSY_LOG_LEVEL=info
